# Required in production. Do not commit real values.
PI_AGENT_API_BEARER_TOKEN=replace-with-a-long-random-token
REDIS_URL=redis://redis:6379/0
DOCUMENT_TRANSLATION_SKILL_DIR=/app/document-translation
PI_AGENT_DATA_ROOT=/data

# OpenAI-compatible endpoint used by both Pi orchestration and translation_core.
OPENAI_BASE_URL=https://models.example.com/v1
OPENAI_API_KEY=replace-at-deploy-time
OPENAI_MODEL=your-model-id
PI_MODEL_PROVIDER=translation-openai
PI_MODEL_ID=your-model-id

PI_AGENT_HOST=0.0.0.0
PI_AGENT_PORT=8080
PI_AGENT_JOB_CONCURRENCY=20
PI_AGENT_TRANSLATION_CONCURRENCY=4
PI_AGENT_PROVIDER_MAX_CONCURRENCY=20
PI_AGENT_SEMANTIC_QA_ENABLED=true
PI_AGENT_PROCESSING_REPAIR_ENABLED=true
PI_AGENT_RATE_LIMIT_MAX=20
PI_AGENT_RATE_LIMIT_DURATION_MS=1000
PI_AGENT_DEFAULT_REPAIR_ROUNDS=2
PI_AGENT_HARD_MAX_REPAIR_ROUNDS=3
PI_AGENT_SOFT_TIMEOUT_SECONDS=1620
PI_AGENT_HARD_TIMEOUT_SECONDS=2100
PI_AGENT_PYTHON_EXECUTABLE=python3
PI_AGENT_PYTHON_MODULE=format_translator.agent_tool_cli
FORMAT_TRANSLATOR_SOFFICE_PATH=/usr/bin/soffice

# Optional: enables registration by a relative key under this fixed root.
# PI_AGENT_SOURCE_REGISTRATION_ROOT=/data/incoming

# Test-only. Never enable in production.
PI_AGENT_FIXTURE_MODE=false
