# Copy this file to .env.pi for a local deployment. In production, inject
# secrets from the platform secret manager instead of committing this file.

PI_AGENT_IMAGE=format-translator-pi-agent:0.1.0
REDIS_IMAGE=redis:7.4-alpine

# Pi orchestration model. Never commit a real key.
PI_MODEL_PROVIDER=translation-openai
# Leave empty to reuse OPENAI_MODEL. With the generated OpenAI-compatible
# provider, a non-empty value must name the same registered model.
PI_MODEL_ID=
PI_AGENT_API_BEARER_TOKEN=replace-with-random-api-token

# Document translation provider. It may be the same provider, but is limited
# independently from Pi orchestration calls.
OPENAI_BASE_URL=https://your-translation-provider.example/v1
OPENAI_API_KEY=replace-with-secret-manager-reference
OPENAI_MODEL=replace-with-translation-model

# 20 means active document jobs. Provider calls and LibreOffice processes use
# separate limits to protect upstream quotas and machine resources.
PI_AGENT_JOB_CONCURRENCY=20
PI_AGENT_PROVIDER_MAX_CONCURRENCY=20
PI_AGENT_TRANSLATION_CONCURRENCY=4
PI_AGENT_RATE_LIMIT_MAX=20
PI_AGENT_RATE_LIMIT_DURATION_MS=1000
FORMAT_TRANSLATOR_LIBREOFFICE_MAX_WORKERS=3

PI_AGENT_SOFT_TIMEOUT_SECONDS=1620
PI_AGENT_HARD_TIMEOUT_SECONDS=2100
PI_AGENT_DEFAULT_REPAIR_ROUNDS=2
PI_AGENT_HARD_MAX_REPAIR_ROUNDS=3
PI_AGENT_SEMANTIC_QA_ENABLED=true
PI_AGENT_PROCESSING_REPAIR_ENABLED=true
PI_AGENT_PYTHON_TOOL_TIMEOUT_SECONDS=1200
PI_AGENT_MAX_INPUT_BYTES=52428800
PI_AGENT_THINKING_LEVEL=low
PI_AGENT_QUEUE_NAME=format-translator-pi-agent

FORMAT_TRANSLATOR_LIBREOFFICE_QUEUE_TIMEOUT_SECONDS=120
FORMAT_TRANSLATOR_LIBREOFFICE_TIMEOUT_SECONDS=120

# Use redis://redis:6379/0 for the private Compose network. Use rediss:// and
# an injected credential when Redis is external.
REDIS_URL=redis://redis:6379/0

PI_AGENT_CPU_LIMIT=8
PI_AGENT_MEMORY_LIMIT=12g
PI_AGENT_HOST_PORT=8080
